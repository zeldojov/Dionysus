{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://dionysus.local/schemas/document.schema.json",
    "title": "Dionysus document",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "blocks"
    ],
    "properties": {
        "schemaVersion": {
            "const": 3
        },
        "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/paragraphBlock"
            }
        }
    },
    "$defs": {
        "paragraphBlock": {
            "title": "Paragraph block",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "text"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "const": "paragraph"
                },
                "text": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*$"
                },
                "align": {
                    "type": "string",
                    "enum": [
                        "left",
                        "center",
                        "right",
                        "justify"
                    ],
                    "default": "left"
                },
                "marks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/paragraphMark"
                    }
                },
                "links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/paragraphLink"
                    }
                },
                "references": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/paragraphReference"
                    }
                }
            }
        },
        "paragraphMark": {
            "title": "Inline paragraph mark",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end",
                "style"
            ],
            "properties": {
                "start": {
                    "type": "integer",
                    "minimum": 0
                },
                "end": {
                    "type": "integer",
                    "minimum": 0
                },
                "style": {
                    "type": "string",
                    "enum": [
                        "bold",
                        "italic",
                        "underline",
                        "strike",
                        "highlight",
                        "color",
                        "subscript",
                        "superscript"
                    ]
                }
            }
        },
        "paragraphLink": {
            "title": "Paragraph link range",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end",
                "url"
            ],
            "properties": {
                "start": {
                    "type": "integer",
                    "minimum": 0
                },
                "end": {
                    "type": "integer",
                    "minimum": 1
                },
                "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                }
            }
        },
        "paragraphReference": {
            "title": "Paragraph reference range",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end",
                "documentId",
                "blockId"
            ],
            "properties": {
                "start": {
                    "type": "integer",
                    "minimum": 0
                },
                "end": {
                    "type": "integer",
                    "minimum": 0
                },
                "documentId": {
                    "type": "string",
                    "minLength": 1
                },
                "blockId": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}